# Copy this file to .env and fill in the real values. Never commit .env.

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Gmail account that sends lead emails, plus a Google *app password* for it
# (Google Account > Security > 2-Step Verification > App passwords)
GMAIL_ADDRESS=kennethtang.leads@gmail.com
GMAIL_APP_PASSWORD=

# Optional: your own address. Gets a BCC copy of every lead from every business.
OPERATOR_BCC_EMAIL=

# Optional: where leads and conversation logs are written (default ./data).
# On Render, point this at the persistent disk, e.g. /var/data
DATA_DIR=

# Optional: random string used when hashing visitor IPs in the logs.
VISITOR_HASH_SALT=

# Optional: how many proxies sit in front of the app. The visitor IP (for rate limits) is taken from the
# right end of X-Forwarded-For, so 1 = use the last entry. Use 0 to ignore the header.
TRUSTED_PROXY_HOPS=

# Optional: set to 1 on a new host to log the raw X-Forwarded-For header for each chat request, so you
# can check that the right entry is being used. Turn it off afterwards (it logs visitor IPs).
LOG_CLIENT_IP_DEBUG=

# The public https address of this app, used in the chat-bubble script (no trailing slash), e.g.
# https://chat.yourdomain.com. On Render it defaults to the service's onrender.com URL, so you only
# need this if you use a custom domain. Locally, leave it blank.
PUBLIC_BASE_URL=
